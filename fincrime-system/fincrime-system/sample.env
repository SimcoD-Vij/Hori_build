# ═══════════════════════════════════════════════════════
# Fincrime System — Environment Configuration (Sample)
# ═══════════════════════════════════════════════════════

# ── Main fincrime FastAPI app ────────────────────────────
LLM_PROVIDER=template
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# ── Dograh Voice Engine (Port 8083) ──────────────────────
# Get these from: http://localhost:3010 → Settings → API Keys
DOGRAH_API_URL=http://dograh-api:8000
DOGRAH_API_KEY=your_dograh_api_key_here
DOGRAH_WORKFLOW_ID=2
Dograh_call_trigger=your_dograh_call_trigger_uuid_here

# URL Dograh uses to POST call-completed webhooks back to this server
THIS_SERVICE_URL=http://host.docker.internal:8083

# ── Ollama (running natively on Windows, reachable from Docker) ───
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_SUMMARIZATION_MODEL=qwen2.5-coder:7b

# ── Shared audit log path ─────────────────────────────────
FINCRIME_AUDIT_LOG=/app/data/audit_log.jsonl

# ── Twilio (for when you want direct telephony, not via Dograh) ──
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
